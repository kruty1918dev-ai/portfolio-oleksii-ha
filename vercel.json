{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/quiet-camp/privacy", "destination": "/quiet-camp/privacy/index.html" },
    { "source": "/quiet-camp/privacy/uk", "destination": "/quiet-camp/privacy/uk/index.html" },
    { "source": "/quiet-camp/privacy/de", "destination": "/quiet-camp/privacy/de/index.html" }
  ],
  "headers": [
    {
      "source": "/quiet-camp/privacy(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
