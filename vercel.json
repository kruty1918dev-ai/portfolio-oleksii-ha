    {
      "source": "/portfolio",
      "destination": "/portfolio/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/quiet-camp",
      "destination": "/quiet-camp/index.html"
    },
    {
      "source": "/moyva",
      "destination": "/moyva/index.html"
    },
    {
      "source": "/fun-and-ball",
      "destination": "/fun-and-ball/index.html"
    },
    {
      "source": "/quiet-camp/legal",
      "destination": "/quiet-camp/legal/index.html"
    },
    {
      "source": "/quiet-camp/account",
      "destination": "/quiet-camp/account/index.html"
    },
    {
      "source": "/quiet-camp/delete-account",
      "destination": "/quiet-camp/delete-account/index.html"
    },
    {
      "source": "/impressum",
      "destination": "/impressum/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
