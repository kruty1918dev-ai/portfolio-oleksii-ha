{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/games",
      "destination": "/games/index.html"
    },
    {
      "source": "/portfolio",
      "destination": "/portfolio/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/quiet-camp",
      "destination": "/quiet-camp/index.html"
    },
    {
      "source": "/moyva",
      "destination": "/moyva/index.html"
    },
    {
      "source": "/fun-and-ball",
      "destination": "/fun-and-ball/index.html"
    },
    {
      "source": "/impressum",
      "destination": "/impressum/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/quiet-camp/privacy",
      "destination": "/quiet-camp/privacy/index.html"
    },
    {
      "source": "/uk",
      "destination": "/uk/index.html"
    },
    {
      "source": "/games/uk",
      "destination": "/games/uk/index.html"
    },
    {
      "source": "/portfolio/uk",
      "destination": "/portfolio/uk/index.html"
    },
    {
      "source": "/about/uk",
      "destination": "/about/uk/index.html"
    },
    {
      "source": "/quiet-camp/uk",
      "destination": "/quiet-camp/uk/index.html"
    },
    {
      "source": "/moyva/uk",
      "destination": "/moyva/uk/index.html"
    },
    {
      "source": "/fun-and-ball/uk",
      "destination": "/fun-and-ball/uk/index.html"
    },
    {
      "source": "/impressum/uk",
      "destination": "/impressum/uk/index.html"
    },
    {
      "source": "/privacy/uk",
      "destination": "/privacy/uk/index.html"
    },
    {
      "source": "/quiet-camp/privacy/uk",
      "destination": "/quiet-camp/privacy/uk/index.html"
    },
    {
      "source": "/de",
      "destination": "/de/index.html"
    },
    {
      "source": "/games/de",
      "destination": "/games/de/index.html"
    },
    {
      "source": "/portfolio/de",
      "destination": "/portfolio/de/index.html"
    },
    {
      "source": "/about/de",
      "destination": "/about/de/index.html"
    },
    {
      "source": "/quiet-camp/de",
      "destination": "/quiet-camp/de/index.html"
    },
    {
      "source": "/moyva/de",
      "destination": "/moyva/de/index.html"
    },
    {
      "source": "/fun-and-ball/de",
      "destination": "/fun-and-ball/de/index.html"
    },
    {
      "source": "/impressum/de",
      "destination": "/impressum/de/index.html"
    },
    {
      "source": "/privacy/de",
      "destination": "/privacy/de/index.html"
    },
    {
      "source": "/quiet-camp/privacy/de",
      "destination": "/quiet-camp/privacy/de/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/cv",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/lebenslauf",
      "destination": "/about/de",
      "permanent": true
    },
    {
      "source": "/funandball",
      "destination": "/fun-and-ball",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/about#contact",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; style-src 'self'; img-src 'self'; script-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
