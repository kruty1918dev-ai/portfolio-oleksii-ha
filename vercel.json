      "destination": "/about/uk/index.html"
    },
    {
      "source": "/quiet-camp/uk",
      "destination": "/quiet-camp/uk/index.html"
    },
    {
      "source": "/moyva/uk",
      "destination": "/moyva/uk/index.html"
    },
    {
      "source": "/fun-and-ball/uk",
      "destination": "/fun-and-ball/uk/index.html"
    },
    {
      "source": "/quiet-camp/legal/uk",
      "destination": "/quiet-camp/legal/uk/index.html"
