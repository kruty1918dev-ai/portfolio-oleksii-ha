      "destination": "/privacy/uk/index.html"
    },
    {
      "source": "/quiet-camp/privacy/uk",
      "destination": "/quiet-camp/privacy/uk/index.html"
    },
    {
      "source": "/de",
      "destination": "/de/index.html"
    },
    {
      "source": "/games/de",
      "destination": "/games/de/index.html"
    },
    {
      "source": "/portfolio/de",
      "destination": "/portfolio/de/index.html"
    },
    {
      "source": "/about/de",
      "destination": "/about/de/index.html"
    },
    {
      "source": "/quiet-camp/de",
      "destination": "/quiet-camp/de/index.html"
    },
    {
      "source": "/moyva/de",
      "destination": "/moyva/de/index.html"
    },
    {
      "source": "/fun-and-ball/de",
