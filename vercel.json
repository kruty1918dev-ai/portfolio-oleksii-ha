    {
      "source": "/privacy/de",
      "destination": "/privacy/de/index.html"
    },
    {
      "source": "/quiet-camp/privacy/de",
      "destination": "/quiet-camp/privacy/de/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/cv",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/lebenslauf",
      "destination": "/about/de",
      "permanent": true
    },
    {
      "source": "/funandball",
      "destination": "/fun-and-ball",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/about#contact",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; style-src 'self'; img-src 'self'; script-src 'self' 'sha256-FCHv6GQEX4Xc6dDY671GyTzo62GAU6qqJhsj4jtE5uM=' 'sha256-2xlCEbh6jLEC7vlInMRfdkjT0VL/nV72Dm9WX5SadfY=' 'sha256-wNOi1IJLkYn0HhWLdTs5cIkEWLaKJiIej8CTnztcAQA=' 'sha256-84b/5yw2rtizICdqlXWWItZWwsso696AQLdLSEz6P+U=' 'sha256-Hmh6MpFCR/qI5rslvsAFKuC0pU/Ec7djaEvpceru2Ow=' 'sha256-nwdVGRedMq2ZqcwzwjTg4rP/Xf/3T/k0IvUlUpszJp8=' 'sha256-d1AAJCWv247nVbfyYoiT3JPSmfSO4ZxVfaMm75Z/NmM=' 'sha256-A/8TsGfnxTVV3chrB/yDw5FjK2A7Ffq6XXtzz0K3spI=' 'sha256-rwStWVMKwFtI84U3YSfnOv8uiv7LEmviT0IKhetSIJo=' 'sha256-+b24wzMux2uZfS+YEdtVAm8iYRemXyOK1P4BsrUigcw=' 'sha256-1GCVLFgnPegHwItQRS8GSmRWyIAhdmrFtZsL30vT5Z8=' 'sha256-0kSV9SeysUSLl/DJ+tqyCLdqu+ygaOjL5BmkZbwec0k='; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/app-ads.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
