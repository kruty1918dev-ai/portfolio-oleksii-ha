    {
      "source": "/quiet-camp/legal/de",
      "destination": "/quiet-camp/legal/de/index.html"
    },
    {
      "source": "/quiet-camp/account/de",
      "destination": "/quiet-camp/account/de/index.html"
    },
    {
      "source": "/quiet-camp/delete-account/de",
